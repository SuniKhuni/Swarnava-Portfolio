# Public origin — metadata, sitemap.xml, robots.txt, JSON-LD
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form. With both set, messages send through Resend; without them the form
# falls back to the visitor's mail app (mailto:).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Sender address on a domain verified in Resend (defaults to Resend's onboarding sender)
CONTACT_FROM_EMAIL=

# Live subscriber counts on the client cards (YouTube Data API v3, free quota). Counts are
# fetched on the server, cached for a day; without a key the static `meta` line shows.
YOUTUBE_API_KEY=

# /admin — the content dashboard. Both required, or /admin stays locked.
# Quote the password if it contains # or spaces. Changing it signs out every session.
ADMIN_PASSWORD=
# Long random string that signs the admin session cookie, e.g. `openssl rand -base64 32`.
ADMIN_SECRET=

# Supabase (production on Vercel): content in the `site_content` table, admin uploads in the
# public `media` bucket. With both set, /admin saves there; without them it uses local files.
SUPABASE_URL=
# Project Settings → API → service_role. Secret: server only, never in client code.
SUPABASE_SERVICE_ROLE_KEY=
